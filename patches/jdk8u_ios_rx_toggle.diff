 address os::Bsd::debug_jit_mapping_mirrored = NULL;
 
+////////////////////////////////////////////////////////////////////////////////
+// Air2 (JIT26) RX toggle
+//
+// Everything that writes into the code cache through mirror_w() lands in the RW
+// alias, which needs no page protection games.  But some jdk8 paths write into
+// code cache pages with a plain store (CodeHeap/CodeBlob bookkeeping, the
+// occasional direct field patch), and those hit pages that are PROT_READ|
+// PROT_EXEC in the alias the CPU executes from.
+//
+// Those stores must not be redirected to the RW alias: on XNU a second mapping
+// that is made writable while its twin stays executable may be turned into a
+// private copy-on-write mapping, in which case a store through the RW alias is
+// simply not visible through the RX alias - the reader then sees a stale block
+// header and the CodeHeap free list silently stops working (device symptom:
+// "used=11MB, free=152MB, not enough contiguous free space left").
+//
+// So the store is performed on the page the reader will look at: the page is
+// switched to writable, the faulting store is retried by the kernel on return
+// from the signal handler, and the page is switched back to RX at the next
+// safepoint (or as soon as somebody asks for the executable alias again).
+// RWX is tried first so that a writable page never loses PROT_EXEC; only when
+// iOS refuses the W+X page (the usual case on hardened devices) do we fall back
+// to RW, in which case the instruction fetch fault path below puts EXEC back.
+////////////////////////////////////////////////////////////////////////////////
+address os::Bsd::debug_jit_rx_base = NULL;
+size_t  os::Bsd::debug_jit_rx_size = 0;
+
+enum {
+  A2_RX_PAGE_RX  = 0,   // PROT_READ|PROT_EXEC      (steady state)
+  A2_RX_PAGE_RW  = 1,   // PROT_READ|PROT_WRITE     (exec dropped, must restore)
+  A2_RX_PAGE_RWX = 2    // PROT_READ|PROT_WRITE|PROT_EXEC
+};
+
+static address      a2_rx_window_base = NULL;    // RX alias base (recorded)
+static size_t       a2_rx_window_size = 0;
+static size_t       a2_rx_page_size   = 0;
+static unsigned char* a2_rx_page_state = NULL;   // one byte per page
+static size_t       a2_rx_page_count  = 0;
+static volatile int a2_rx_dirty_pages = 0;
+static volatile long a2_rx_fault_count = 0;
+static volatile long a2_rx_flip_count  = 0;
+static volatile long a2_rx_fail_count  = 0;
+static bool         a2_rx_lock_ready  = false;
+static pthread_mutex_t a2_rx_lock;
+
+// Hard stop so that a genuine wild store into the code cache window still ends
+// up in the normal crash handler instead of being papered over for ever.
+#define A2_RX_MAX_FLIPS 8192
+
+static bool a2_rx_enabled() {
+  return os::Bsd::debug_jit_mapping_mirrored != NULL &&
+         a2_rx_window_base != NULL && a2_rx_page_count != 0;
+}
+
+static size_t a2_rx_page_align_down(address addr) {
+  return (size_t)addr & ~(a2_rx_page_size - 1);
+}
+
+// Clamp [addr, addr+len) to whole pages inside the mirrored window.
+static bool a2_rx_page_range(address addr, size_t len, address* beg, address* end) {
+  if (a2_rx_page_size == 0 || a2_rx_window_base == NULL) return false;
+  if (len == 0) len = 1;
+  address win_lo = a2_rx_window_base;
+  address win_hi = a2_rx_window_base + a2_rx_window_size;
+  size_t lo = a2_rx_page_align_down(addr);
+  size_t hi = a2_rx_page_align_down(addr + len - 1) + a2_rx_page_size;
+  if (lo < (size_t)win_lo) lo = (size_t)win_lo;
+  if (hi > (size_t)win_hi) hi = (size_t)win_hi;
+  if (hi <= lo) return false;
+  *beg = (address)lo;
+  *end = (address)hi;
+  return true;
+}
+
+// Called from get_debug_jit_mapping() once the RX/RW pair exists.
+static void a2_rx_init_window(address rx_base, size_t size) {
+  if (rx_base == NULL || size == 0) return;
+
+  long ps = ::sysconf(_SC_PAGESIZE);
+  if (ps <= 0) ps = 16384;              // arm64 iOS/macOS default
+  a2_rx_page_size = (size_t)ps;
+
+  if (a2_rx_window_base != NULL && a2_rx_window_base != rx_base) {
+    // Only one mirrored code cache is expected (one CodeHeap).  A second one
+    // means the single global pair in os_bsd.hpp is being reused, which makes
+    // mirror_w()/mirror_x() translate to the wrong alias - worth knowing.
+    printf("[JIT26] WARNING: second mirrored mapping (was %p, now %p)\n",
+           (void*)a2_rx_window_base, (void*)rx_base);
+    if (a2_rx_page_state != NULL) ::free(a2_rx_page_state);
+    a2_rx_page_state = NULL;
+    a2_rx_page_count = 0;
+    a2_rx_dirty_pages = 0;
+  }
+
+  size_t pages = (size + a2_rx_page_size - 1) / a2_rx_page_size;
+  unsigned char* state = (unsigned char*)::malloc(pages);
+  if (state == NULL) {
+    printf("[JIT26] RX toggle: cannot track %lu pages, staying inert\n", (unsigned long)pages);
+    return;
+  }
+  memset(state, A2_RX_PAGE_RX, pages);
+
+  if (!a2_rx_lock_ready) {
+    pthread_mutexattr_t attr;
+    if (pthread_mutexattr_init(&attr) == 0) {
+      // Recursive so that a nested a2_rx_make_writable() call inside the same
+      // thread (signal handler interrupting a flipper) cannot deadlock.
+      pthread_mutexattr_settype(&attr, PTHREAD_MUTEX_RECURSIVE);
+      if (pthread_mutex_init(&a2_rx_lock, &attr) != 0) {
+        pthread_mutex_init(&a2_rx_lock, NULL);
+      }
+      pthread_mutexattr_destroy(&attr);
+    } else {
+      pthread_mutex_init(&a2_rx_lock, NULL);
+    }
+    a2_rx_lock_ready = true;
+  }
+
+  a2_rx_page_state = state;
+  a2_rx_page_count = pages;
+  a2_rx_window_base = rx_base;
+  a2_rx_window_size = size;
+  os::Bsd::debug_jit_rx_base = rx_base;
+  os::Bsd::debug_jit_rx_size = size;
+
+  printf("[JIT26] RX toggle armed: base=%p size=%luMB page=%luKB\n",
+         (void*)rx_base, (unsigned long)(size / (1024 * 1024)),
+         (unsigned long)(a2_rx_page_size / 1024));
+}
+
+bool os::Bsd::a2_rx_contains(address addr) {
+  return a2_rx_window_base != NULL &&
+         addr >= a2_rx_window_base &&
+         addr <  a2_rx_window_base + a2_rx_window_size;
+}
+
+// Switch the pages covering [addr, addr+len) to writable.  Returns true when at
+// least one page was (or already is) writable.  Safe to call from a signal
+// handler: takes the lock with trylock, and mprotect() itself is atomic.
+bool os::Bsd::a2_rx_make_writable(address addr, size_t len) {
+  address beg, end;
+  if (!a2_rx_enabled()) return false;
+  if (!a2_rx_page_range(addr, len, &beg, &end)) return false;
+
+  bool locked = a2_rx_lock_ready && (pthread_mutex_trylock(&a2_rx_lock) == 0);
+  bool ok = false;
+
+  for (address p = beg; p < end; p += a2_rx_page_size) {
+    size_t i = (size_t)(p - a2_rx_window_base) / a2_rx_page_size;
+    if (i >= a2_rx_page_count) break;
+    if (a2_rx_page_state[i] != A2_RX_PAGE_RX) { ok = true; continue; }  // already writable
+
+    if (a2_rx_flip_count >= A2_RX_MAX_FLIPS) {
+      printf("[JIT26] RX toggle: flip limit reached, giving up on %p\n", (void*)p);
+      a2_rx_fail_count++;
+      break;
+    }
+
+    // Prefer RWX: a writable page that keeps PROT_EXEC cannot trap another
+    // thread that happens to be executing code out of the same page.
+    if (::mprotect(p, a2_rx_page_size, PROT_READ | PROT_WRITE | PROT_EXEC) == 0) {
+      a2_rx_page_state[i] = A2_RX_PAGE_RWX;
+    } else if (::mprotect(p, a2_rx_page_size, PROT_READ | PROT_WRITE) == 0) {
+      a2_rx_page_state[i] = A2_RX_PAGE_RW;
+    } else {
+      int err = errno;
+      a2_rx_fail_count++;
+      printf("[JIT26] Failed to make RX region writable: %d (%p)\n", err, (void*)p);
+      continue;
+    }
+    a2_rx_dirty_pages++;
+    a2_rx_flip_count++;
+    ok = true;
+  }
+
+  if (locked) pthread_mutex_unlock(&a2_rx_lock);
+  return ok;
+}
+
+void os::Bsd::a2_rx_restore(address addr, size_t len) {
+  address beg, end;
+  if (!a2_rx_enabled()) return;
+  if (!a2_rx_page_range(addr, len, &beg, &end)) return;
+
+  bool locked = a2_rx_lock_ready && (pthread_mutex_trylock(&a2_rx_lock) == 0);
+
+  for (address p = beg; p < end; p += a2_rx_page_size) {
+    size_t i = (size_t)(p - a2_rx_window_base) / a2_rx_page_size;
+    if (i >= a2_rx_page_count) break;
+    if (a2_rx_page_state[i] == A2_RX_PAGE_RX) continue;
+    if (::mprotect(p, a2_rx_page_size, PROT_READ | PROT_EXEC) == 0) {
+      a2_rx_page_state[i] = A2_RX_PAGE_RX;
+      if (a2_rx_dirty_pages > 0) a2_rx_dirty_pages--;
+    } else {
+      a2_rx_fail_count++;
+      printf("[JIT26] Failed to restore RX protection: %d (%p)\n", errno, (void*)p);
+    }
+  }
+
+  if (locked) pthread_mutex_unlock(&a2_rx_lock);
+}
+
+// Restore every page that was toggled; called at safepoint end, where no thread
+// can be inside a flipped (possibly non-executable) code cache page.
+void os::Bsd::a2_rx_restore_all() {
+  if (!a2_rx_enabled() || a2_rx_dirty_pages == 0) return;
+
+  bool locked = a2_rx_lock_ready && (pthread_mutex_trylock(&a2_rx_lock) == 0);
+  size_t i = 0;
+  while (i < a2_rx_page_count) {
+    if (a2_rx_page_state[i] == A2_RX_PAGE_RX) { i++; continue; }
+    // Coalesce a run of toggled pages into one mprotect.
+    size_t j = i;
+    while (j < a2_rx_page_count && a2_rx_page_state[j] != A2_RX_PAGE_RX) j++;
+    address p = a2_rx_window_base + i * a2_rx_page_size;
+    size_t n  = (j - i) * a2_rx_page_size;
+    if (::mprotect(p, n, PROT_READ | PROT_EXEC) == 0) {
+      memset(a2_rx_page_state + i, A2_RX_PAGE_RX, j - i);
+      a2_rx_dirty_pages -= (int)(j - i);
+      if (a2_rx_dirty_pages < 0) a2_rx_dirty_pages = 0;
+    } else {
+      a2_rx_fail_count++;
+      printf("[JIT26] Failed to restore RX protection: %d (%p, %lu pages)\n",
+             errno, (void*)p, (unsigned long)(j - i));
+    }
+    i = j;
+  }
+  if (locked) pthread_mutex_unlock(&a2_rx_lock);
+}
+
+static address a2_rx_fault_address(siginfo_t* info, void* ucVoid) {
+  if (info != NULL && info->si_addr != NULL) {
+    return (address)info->si_addr;
+  }
+#ifdef __DARWIN_ARM64
+  if (ucVoid != NULL) {
+    ucontext_t* uc = (ucontext_t*)ucVoid;
+    if (uc->uc_mcontext != NULL) {
+      return (address)(uintptr_t)uc->uc_mcontext->__es.__far;
+    }
+  }
+#endif
+  return NULL;
+}
+
+// Returns true when the fault was handled and the faulting instruction should be
+// retried by the kernel (i.e. the signal handler returns "handled").
+bool os::Bsd::a2_rx_handle_fault(int sig, siginfo_t* info, void* ucVoid) {
+  if (!a2_rx_enabled()) return false;
+
+  a2_rx_fault_count++;
+
+  address far = a2_rx_fault_address(info, ucVoid);
+  address pc  = (ucVoid != NULL) ? os::Bsd::ucontext_get_pc((ucontext_t*)ucVoid) : NULL;
+
+  // (a) instruction fetch faulted inside the window: the page lost PROT_EXEC
+  //     (we had to fall back to RW).  Put EXEC back and retry.
+  if (pc != NULL && a2_rx_contains(pc) && (far == NULL || far == pc)) {
+    if (a2_rx_make_writable(pc, 1)) {
+      // make_writable() prefers RWX, which is exactly what the fetch needs.
+      if (a2_rx_fault_count <= 8) {
+        printf("[JIT26] RX toggle: restored exec on fetch fault at %p\n", (void*)pc);
+      }
+      return true;
+    }
+    a2_rx_restore(pc, 1);
+    return true;
+  }
+
+  // (b) data store into a page that is still RX: toggle it and let the store be
+  //     retried.  The page is switched back at the next safepoint.
+  if (far != NULL && a2_rx_contains(far)) {
+    if (a2_rx_make_writable(far, 1)) {
+      if (a2_rx_fault_count <= 8) {
+        printf("[JIT26] RX toggle: write fault at %p made writable (pc=%p)\n",
+               (void*)far, (void*)pc);
+      }
+      return true;
+    }
+    printf("[JIT26] RX toggle: cannot handle write fault at %p, falling through\n", (void*)far);
+    return false;
+  }
+
+  return false;
+}
+
