index 2b49abb5..11e864d8 100644
--- a/hotspot/src/share/vm/runtime/os.hpp
+++ b/hotspot/src/share/vm/runtime/os.hpp
@@ -25,6 +25,42 @@
 #ifndef SHARE_VM_RUNTIME_OS_HPP
 #define SHARE_VM_RUNTIME_OS_HPP
 
+// Air2 (JIT26) mirror-mapped code cache helpers.
+//
+// The code cache is mapped twice: an "RX" alias (PROT_READ|PROT_EXEC) that the
+// CPU executes from and that CodeCache/CodeBlob keep as the canonical address,
+// and an "RW" alias (PROT_READ|PROT_WRITE, vm_remap of the same pages) where all
+// writes into the code cache are redirected to.
+//
+//   mirror_w(p)  - convert to the writable alias (identity for other pointers)
+//   mirror_x(p)  - convert to the executable alias (identity for other pointers)
+//   mirror_w_set(lvalue) - store through the writable alias
+//
+// Both directions are idempotent, so they may be applied to a pointer of either
+// flavour.  They are defined here rather than in os_bsd.hpp because os.hpp pulls
+// in runtime/atomic.hpp -> utilities/bytes.hpp -> bytes_aarch64.hpp, which
+// already uses mirror_w(); at that point os_bsd.hpp has not been included yet.
+//
+// Note: decltype() is C++11 and jdk8 hotspot is built with -std=gnu++98, hence
+// the function templates instead of jdk17's `decltype` based macros.
+#ifdef __APPLE__
+char* os_mirror_find_rw(char* p);   // defined in os_bsd.cpp
+char* os_mirror_find_rx(char* p);
+template <typename T> inline T mirror_find_rw(T p) {
+  return (T)(char*)os_mirror_find_rw((char*)(void*)p);
+}
+template <typename T> inline T mirror_find_rx(T p) {
+  return (T)(char*)os_mirror_find_rx((char*)(void*)p);
+}
+#define mirror_w(x)     mirror_find_rw(x)
+#define mirror_x(x)     mirror_find_rx(x)
+#define mirror_w_set(x) (*mirror_find_rw(&(x)))
+#else
+#define mirror_w(x)     (x)
+#define mirror_x(x)     (x)
+#define mirror_w_set(x) (x)
+#endif
+
 #include "jvmtifiles/jvmti.h"
 #include "runtime/atomic.hpp"
 #include "runtime/extendedPC.hpp"
